        <mxCell id="s7WMvg4QZF4kne-S9XOI-41" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#FF0000;" value="" vertex="1">
          <mxGeometry height="20" width="270" x="3380" y="1900" as="geometry" />
        </mxCell>
        <mxCell id="s7WMvg4QZF4kne-S9XOI-42" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;strokeColor=none;fillColor=#fff2cc;" value="&lt;div&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;1. 开启事务&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;----&amp;gt;conn.setAutoCommit(false)&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;JDBC默认true&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;数据库连接池 false&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;2. 获取事务的状态&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;TransactionStatus&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="220" x="3830" y="1790" as="geometry" />
        </mxCell>
        <mxCell id="s7WMvg4QZF4kne-S9XOI-44" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="331" width="517.68" x="3640" y="850" as="geometry" />
        </mxCell>
        <mxCell id="s7WMvg4QZF4kne-S9XOI-49" edge="1" parent="1" source="s7WMvg4QZF4kne-S9XOI-46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#FF0000;" target="s7WMvg4QZF4kne-S9XOI-48">
          <mxGeometry relative="1" as="geometry" />
