        <mxCell id="rPPMhUUU6-zgN3zvUCfC-10" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#FF0000;" value="" vertex="1">
          <mxGeometry height="20" width="190" x="650" y="940" as="geometry" />
        </mxCell>
        <mxCell id="rPPMhUUU6-zgN3zvUCfC-11" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;strokeColor=none;fillColor=#fff2cc;" value="&lt;div&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;这两种方式的效果是一样的&lt;/span&gt;&lt;/div&gt;&lt;div&gt;为什么要进行一层包装&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;语义化的设计 含义表达更清晰&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="210" x="320" y="900" as="geometry" />
        </mxCell>
        <mxCell id="rPPMhUUU6-zgN3zvUCfC-12" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;strokeColor=none;fillColor=#fff2cc;" value="&lt;div&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;Spring AOP&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;1. BeanPostProcessor&amp;nbsp; 最终完成后以 JDK 或 CGLIB 的形式创建代理&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;2. 创建代理的这个BeanPostProcessor在Spring 源码中什么位置执行的？&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;创建对象&amp;nbsp; &amp;nbsp; 属性填充&amp;nbsp; &amp;nbsp;初始化【进行】&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="420" x="650" y="1090" as="geometry" />
        </mxCell>
        <mxCell id="rPPMhUUU6-zgN3zvUCfC-13" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;strokeColor=#6c8ebf;fillColor=#dae8fc;" value="&lt;div&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;ExposedProxy分析&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="210" x="650" y="1310" as="geometry" />
        </mxCell>
        <mxCell id="rPPMhUUU6-zgN3zvUCfC-14" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;strokeColor=none;fillColor=#fff2cc;" value="&lt;div&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;问题&lt;/span&gt;&lt;/div&gt;&lt;div&gt;public class XxxService{&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;m1(){&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;m2();&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;// this.m2();&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;// 没有添加上额外功能，不是代理对象调用的&lt;br&gt;&lt;/div&gt;&lt;div&gt;/*&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#ff0000&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;方法1：实现ApplicationContextAware 接口&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#ff0000&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;方法2：在@EnableAspectJAutoProxy中设置 exposeProxy = true&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#ff0000&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;将创建的代理对象存放在 ThreadLocal 中，用AopContext 取&lt;/font&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;*/&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;m2(){&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;}&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;" vertex="1">
          <mxGeometry height="231" width="430" x="650" y="1399" as="geometry" />
        </mxCell>
        <mxCell id="rPPMhUUU6-zgN3zvUCfC-15" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;background-color:#1e1f22;color:#bcbec4&quot;&gt;&lt;pre style=&quot;font-family:&#39;微软雅黑&#39;;font-size:12.0pt;&quot;&gt;&lt;span style=&quot;color:#b3ae60;&quot;&gt;@Override&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#cf8e6d;&quot;&gt;public &lt;/span&gt;Object &lt;span style=&quot;color:#56a8f5;&quot;&gt;postProcessAfterInitialization&lt;/span&gt;(&lt;span style=&quot;color:#b3ae60;&quot;&gt;@Nullable &lt;/span&gt;Object bean, String beanName) {&lt;br&gt;    &lt;span style=&quot;color:#cf8e6d;&quot;&gt;if &lt;/span&gt;(bean != &lt;span style=&quot;color:#cf8e6d;&quot;&gt;null&lt;/span&gt;) {&lt;br&gt;       Object cacheKey = getCacheKey(bean.getClass(), beanName);&lt;br&gt;       &lt;span style=&quot;color:#cf8e6d;&quot;&gt;if &lt;/span&gt;(&lt;span style=&quot;color:#cf8e6d;&quot;&gt;this&lt;/span&gt;.&lt;span style=&quot;color:#c77dbb;&quot;&gt;earlyProxyReferences&lt;/span&gt;.remove(cacheKey) != bean) {&lt;br&gt;          &lt;span style=&quot;color:#cf8e6d;&quot;&gt;return &lt;/span&gt;wrapIfNecessary(bean, beanName, cacheKey);&lt;br&gt;       }&lt;br&gt;    }&lt;br&gt;    &lt;span style=&quot;color:#cf8e6d;&quot;&gt;return &lt;/span&gt;bean;&lt;br&gt;}&lt;br&gt;&lt;/pre&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="220" width="670" x="650" y="1730" as="geometry" />
        </mxCell>
