<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36" pages="2">
  <diagram name="事务" id="Bnbjs7SCK2Fh5WnVe2tH">
    <mxGraphModel dx="3229" dy="1273" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="GGYdeEh8H_lDfbDXhspZ-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;dashPattern=1 2;" value="Spring事务源码分析" vertex="1">
          <mxGeometry height="50" width="120" x="340" y="60" as="geometry" />
        </mxCell>
        <mxCell id="GGYdeEh8H_lDfbDXhspZ-2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;strokeColor=none;fillColor=#fff2cc;" value="&lt;div&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;1. 什么是事务&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;保证事务操作完整性的一种数据库机制（diver驱动）&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;2. 事务特点&amp;nbsp; &amp;nbsp;ACID&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;A 原子性&amp;nbsp;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;C 一致性&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;I&amp;nbsp; 隔离性&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;D 持久性&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;3. 事务处理&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;1. 单机版事务（单体）&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Connection（JDBC,Hiberate,Mybatis）&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;2. 分布式事务&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;4. Spring 控制事务&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;核心要点：通过AOP方式创建事务&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;控制事务的编程方式&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;1. 声明式事务（AOP Proxy代理设计模式 通过配置文件 或者 注解的方式 控制事务）&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;2. 编码 TransactionTemplate（Template 模板设计模式）&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="290" width="570" x="340" y="160" as="geometry" />
        </mxCell>
        <mxCell id="GGYdeEh8H_lDfbDXhspZ-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#FF0000;" value="" vertex="1">
          <mxGeometry height="20" width="460" x="395" y="410" as="geometry" />
        </mxCell>
        <mxCell id="GGYdeEh8H_lDfbDXhspZ-4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;dashPattern=1 2;" value="声明式事务开发的编码" vertex="1">
          <mxGeometry height="50" width="140" x="340" y="490" as="geometry" />
        </mxCell>
        <mxCell id="GGYdeEh8H_lDfbDXhspZ-6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;strokeColor=none;fillColor=#fff2cc;" value="&lt;div&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;1. 配置文件的方式&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;1. 原始对象&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;2. 额外功能&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;控制&lt;/span&gt;事务的代码&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;事务属性&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;3. 切面&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="220" x="340" y="580" as="geometry" />
        </mxCell>
        <mxCell id="GGYdeEh8H_lDfbDXhspZ-8" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;strokeColor=none;fillColor=#fff2cc;" value="&lt;div&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;Spring对于事务属性 底层 如何实现 事务属性 所产生的效果&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;ISOLATION&amp;nbsp; &amp;nbsp;READONLY&amp;nbsp; &amp;nbsp;TIMEOUT&amp;nbsp; Spring 底层没有实现&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; JDBC规范实现的&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;conn.setTransactionIsolation(Connection.TRANSACTION_REPEATABLE_READ);&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;conn.setReadOnly(false);&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;conn.setNetworkTimeout();&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;异常：Spring实现&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;传播属性 Propagation&lt;/b&gt;：Spring 实现，源码&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="540" x="340" y="750" as="geometry" />
        </mxCell>
        <mxCell id="GGYdeEh8H_lDfbDXhspZ-10" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;strokeColor=none;fillColor=#fff2cc;" value="&lt;div&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;1. Spring声明式事务 AOP = 代理&lt;/span&gt;&lt;/div&gt;&lt;div&gt;2. Spring 事务的底层 依附于 DataSource ---&amp;gt; Connection ---&amp;gt; ThreadLocal中 --- 开启&amp;nbsp; 回滚&amp;nbsp; 提交&lt;/div&gt;&lt;div&gt;3. 额外功能&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;|- DataSourceTransactionManager（PlatformTransactionManager）JDBC&amp;nbsp; Mybatis&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;|- TransactionAttribute&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="540" x="340" y="1020" as="geometry" />
        </mxCell>
        <mxCell id="GGYdeEh8H_lDfbDXhspZ-11" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;background-color:#1e1f22;color:#bcbec4&quot;&gt;&lt;pre style=&quot;font-family:&#39;微软雅黑&#39;;font-size:12.0pt;&quot;&gt;&lt;span style=&quot;color:#cf8e6d;&quot;&gt;public class &lt;/span&gt;TransactionManagementConfigurationSelector &lt;span style=&quot;color:#cf8e6d;&quot;&gt;extends &lt;/span&gt;AdviceModeImportSelector&amp;lt;&lt;span style=&quot;color:#b3ae60;&quot;&gt;EnableTransactionManagement&lt;/span&gt;&amp;gt; {&lt;br&gt;&lt;br&gt;    &lt;span style=&quot;color:#5f826b;font-style:italic;&quot;&gt;/**&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#5f826b;font-style:italic;&quot;&gt;     * Returns {&lt;/span&gt;&lt;span style=&quot;color:#67a37c;font-style:italic;&quot;&gt;@link &lt;/span&gt;&lt;span style=&quot;color:#5f826b;font-style:italic;&quot;&gt;ProxyTransactionManagementConfiguration} or&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#5f826b;font-style:italic;&quot;&gt;     * {&lt;/span&gt;&lt;span style=&quot;color:#67a37c;font-style:italic;&quot;&gt;@code &lt;/span&gt;&lt;span style=&quot;color:#5f826b;font-style:italic;&quot;&gt;AspectJ(Jta)TransactionManagementConfiguration} for {&lt;/span&gt;&lt;span style=&quot;color:#67a37c;font-style:italic;&quot;&gt;@code &lt;/span&gt;&lt;span style=&quot;color:#5f826b;font-style:italic;&quot;&gt;PROXY}&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#5f826b;font-style:italic;&quot;&gt;     * and {&lt;/span&gt;&lt;span style=&quot;color:#67a37c;font-style:italic;&quot;&gt;@code &lt;/span&gt;&lt;span style=&quot;color:#5f826b;font-style:italic;&quot;&gt;ASPECTJ} values of {&lt;/span&gt;&lt;span style=&quot;color:#67a37c;font-style:italic;&quot;&gt;@link &lt;/span&gt;&lt;span style=&quot;color:#b3ae60;font-style:italic;&quot;&gt;EnableTransactionManagement&lt;/span&gt;&lt;span style=&quot;color:#5f826b;font-style:italic;&quot;&gt;#mode()},&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#5f826b;font-style:italic;&quot;&gt;     * respectively.&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#5f826b;font-style:italic;&quot;&gt;     */&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#5f826b;font-style:italic;&quot;&gt;    &lt;/span&gt;&lt;span style=&quot;color:#b3ae60;&quot;&gt;@Override&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#b3ae60;&quot;&gt;    &lt;/span&gt;&lt;span style=&quot;color:#cf8e6d;&quot;&gt;protected &lt;/span&gt;String[] &lt;span style=&quot;color:#56a8f5;&quot;&gt;selectImports&lt;/span&gt;(AdviceMode adviceMode) {&lt;br&gt;       &lt;span style=&quot;color:#cf8e6d;&quot;&gt;switch &lt;/span&gt;(adviceMode) {&lt;br&gt;          &lt;span style=&quot;color:#cf8e6d;&quot;&gt;case &lt;/span&gt;&lt;span style=&quot;color:#c77dbb;font-style:italic;&quot;&gt;PROXY&lt;/span&gt;:&lt;br&gt;             &lt;span style=&quot;color:#cf8e6d;&quot;&gt;return new &lt;/span&gt;String[] {AutoProxyRegistrar.&lt;span style=&quot;color:#cf8e6d;&quot;&gt;class&lt;/span&gt;.getName(),&lt;br&gt;                   ProxyTransactionManagementConfiguration.&lt;span style=&quot;color:#cf8e6d;&quot;&gt;class&lt;/span&gt;.getName()};&lt;br&gt;          &lt;span style=&quot;color:#cf8e6d;&quot;&gt;case &lt;/span&gt;&lt;span style=&quot;color:#c77dbb;font-style:italic;&quot;&gt;ASPECTJ&lt;/span&gt;:&lt;br&gt;             &lt;span style=&quot;color:#cf8e6d;&quot;&gt;return new &lt;/span&gt;String[] {determineTransactionAspectClass()};&lt;br&gt;          &lt;span style=&quot;color:#cf8e6d;&quot;&gt;default&lt;/span&gt;:&lt;br&gt;             &lt;span style=&quot;color:#cf8e6d;&quot;&gt;return null&lt;/span&gt;;&lt;br&gt;       }&lt;br&gt;    }&lt;br&gt;&lt;br&gt;    &lt;span style=&quot;color:#cf8e6d;&quot;&gt;private &lt;/span&gt;String &lt;span style=&quot;color:#56a8f5;&quot;&gt;determineTransactionAspectClass&lt;/span&gt;() {&lt;br&gt;       &lt;span style=&quot;color:#cf8e6d;&quot;&gt;return &lt;/span&gt;(ClassUtils.&lt;span style=&quot;font-style:italic;&quot;&gt;isPresent&lt;/span&gt;(&lt;span style=&quot;color:#6aab73;&quot;&gt;&quot;javax.transaction.Transactional&quot;&lt;/span&gt;, getClass().getClassLoader()) ?&lt;br&gt;             TransactionManagementConfigUtils.&lt;span style=&quot;color:#c77dbb;font-style:italic;&quot;&gt;JTA_TRANSACTION_ASPECT_CONFIGURATION_CLASS_NAME &lt;/span&gt;:&lt;br&gt;             TransactionManagementConfigUtils.&lt;span style=&quot;color:#c77dbb;font-style:italic;&quot;&gt;TRANSACTION_ASPECT_CONFIGURATION_CLASS_NAME&lt;/span&gt;);&lt;br&gt;    }&lt;br&gt;&lt;br&gt;}&lt;/pre&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="560" width="1000" x="1190" y="230" as="geometry" />
        </mxCell>
        <mxCell id="qF84tzhuZDfQTdyKea-Y-15" edge="1" parent="1" source="GGYdeEh8H_lDfbDXhspZ-17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="qF84tzhuZDfQTdyKea-Y-14" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="GGYdeEh8H_lDfbDXhspZ-17" parent="1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="&lt;font style=&quot;vertical-align: inherit;&quot;&gt;&lt;font style=&quot;vertical-align: inherit; font-size: 14px;&quot;&gt;AutoProxyRegistar.java&lt;/font&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="170" x="1200" y="890" as="geometry" />
        </mxCell>
        <UserObject label="&lt;div style=&quot;background-color:#1e1f22;color:#bcbec4&quot;&gt;&lt;pre style=&quot;font-family:&#39;微软雅黑&#39;;font-size:12.0pt;&quot;&gt;&lt;span style=&quot;color:#b3ae60;&quot;&gt;@Override&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#cf8e6d;&quot;&gt;public void &lt;/span&gt;&lt;span style=&quot;color:#56a8f5;&quot;&gt;registerBeanDefinitions&lt;/span&gt;(AnnotationMetadata importingClassMetadata, BeanDefinitionRegistry registry) {&lt;br&gt;    &lt;span style=&quot;color:#cf8e6d;&quot;&gt;boolean &lt;/span&gt;candidateFound = &lt;span style=&quot;color:#cf8e6d;&quot;&gt;false&lt;/span&gt;;&lt;br&gt;    Set&amp;lt;String&amp;gt; annTypes = importingClassMetadata.getAnnotationTypes();&lt;br&gt;    &lt;span style=&quot;color:#cf8e6d;&quot;&gt;for &lt;/span&gt;(String annType : annTypes) {&lt;br&gt;       AnnotationAttributes candidate = AnnotationConfigUtils.&lt;span style=&quot;font-style:italic;&quot;&gt;attributesFor&lt;/span&gt;(importingClassMetadata, annType);&lt;br&gt;       &lt;span style=&quot;color:#cf8e6d;&quot;&gt;if &lt;/span&gt;(candidate == &lt;span style=&quot;color:#cf8e6d;&quot;&gt;null&lt;/span&gt;) {&lt;br&gt;          &lt;span style=&quot;color:#cf8e6d;&quot;&gt;continue&lt;/span&gt;;&lt;br&gt;       }&lt;br&gt;       Object mode = candidate.get(&lt;span style=&quot;color:#6aab73;&quot;&gt;&quot;mode&quot;&lt;/span&gt;);&lt;br&gt;       Object proxyTargetClass = candidate.get(&lt;span style=&quot;color:#6aab73;&quot;&gt;&quot;proxyTargetClass&quot;&lt;/span&gt;);&lt;br&gt;       &lt;span style=&quot;color:#cf8e6d;&quot;&gt;if &lt;/span&gt;(mode != &lt;span style=&quot;color:#cf8e6d;&quot;&gt;null &lt;/span&gt;&amp;amp;&amp;amp; proxyTargetClass != &lt;span style=&quot;color:#cf8e6d;&quot;&gt;null &lt;/span&gt;&amp;amp;&amp;amp; AdviceMode.&lt;span style=&quot;color:#cf8e6d;&quot;&gt;class &lt;/span&gt;== mode.getClass() &amp;amp;&amp;amp;&lt;br&gt;             Boolean.&lt;span style=&quot;color:#cf8e6d;&quot;&gt;class &lt;/span&gt;== proxyTargetClass.getClass()) {&lt;br&gt;          candidateFound = &lt;span style=&quot;color:#cf8e6d;&quot;&gt;true&lt;/span&gt;;&lt;br&gt;          &lt;span style=&quot;color:#cf8e6d;&quot;&gt;if &lt;/span&gt;(mode == AdviceMode.&lt;span style=&quot;color:#c77dbb;font-style:italic;&quot;&gt;PROXY&lt;/span&gt;) {&lt;br&gt;             AopConfigUtils.&lt;span style=&quot;font-style:italic;&quot;&gt;registerAutoProxyCreatorIfNecessary&lt;/span&gt;(registry);&lt;br&gt;             &lt;span style=&quot;color:#cf8e6d;&quot;&gt;if &lt;/span&gt;((Boolean) proxyTargetClass) {&lt;br&gt;                AopConfigUtils.&lt;span style=&quot;font-style:italic;&quot;&gt;forceAutoProxyCreatorToUseClassProxying&lt;/span&gt;(registry);&lt;br&gt;                &lt;span style=&quot;color:#cf8e6d;&quot;&gt;return&lt;/span&gt;;&lt;br&gt;             }&lt;br&gt;          }&lt;br&gt;       }&lt;br&gt;    }&lt;br&gt;    &lt;span style=&quot;color:#cf8e6d;&quot;&gt;if &lt;/span&gt;(!candidateFound &amp;amp;&amp;amp; &lt;span style=&quot;color:#c77dbb;&quot;&gt;logger&lt;/span&gt;.isInfoEnabled()) {&lt;br&gt;       String name = getClass().getSimpleName();&lt;br&gt;       &lt;span style=&quot;color:#c77dbb;&quot;&gt;logger&lt;/span&gt;.info(String.&lt;span style=&quot;font-style:italic;&quot;&gt;format&lt;/span&gt;(&lt;span style=&quot;color:#6aab73;&quot;&gt;&quot;%s was imported but no annotations were found &quot; &lt;/span&gt;+&lt;br&gt;             &lt;span style=&quot;color:#6aab73;&quot;&gt;&quot;having both &#39;mode&#39; and &#39;proxyTargetClass&#39; attributes of type &quot; &lt;/span&gt;+&lt;br&gt;             &lt;span style=&quot;color:#6aab73;&quot;&gt;&quot;AdviceMode and boolean respectively. This means that auto proxy &quot; &lt;/span&gt;+&lt;br&gt;             &lt;span style=&quot;color:#6aab73;&quot;&gt;&quot;creator registration and configuration may not have occurred as &quot; &lt;/span&gt;+&lt;br&gt;             &lt;span style=&quot;color:#6aab73;&quot;&gt;&quot;intended, and components may not be proxied as expected. Check to &quot; &lt;/span&gt;+&lt;br&gt;             &lt;span style=&quot;color:#6aab73;&quot;&gt;&quot;ensure that %s has been @Import&#39;ed on the same class where these &quot; &lt;/span&gt;+&lt;br&gt;             &lt;span style=&quot;color:#6aab73;&quot;&gt;&quot;annotations are declared; otherwise remove the import of %s &quot; &lt;/span&gt;+&lt;br&gt;             &lt;span style=&quot;color:#6aab73;&quot;&gt;&quot;altogether.&quot;&lt;/span&gt;, name, name, name));&lt;br&gt;    }&lt;br&gt;}&lt;/pre&gt;&lt;/div&gt;" id="GGYdeEh8H_lDfbDXhspZ-19">
          <mxCell parent="1" style="text;whiteSpace=wrap;html=1;" vertex="1">
            <mxGeometry height="690" width="890" x="1200" y="910" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="GGYdeEh8H_lDfbDXhspZ-21" parent="1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="&lt;font style=&quot;vertical-align: inherit;&quot;&gt;&lt;font style=&quot;vertical-align: inherit; font-size: 14px;&quot;&gt;AopConfigUtils.java&lt;/font&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="150" x="1190" y="1688" as="geometry" />
        </mxCell>
        <mxCell id="GGYdeEh8H_lDfbDXhspZ-22" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;background-color:#1e1f22;color:#bcbec4&quot;&gt;&lt;pre style=&quot;font-family:&#39;微软雅黑&#39;;font-size:12.0pt;&quot;&gt;&lt;span style=&quot;color:#cf8e6d;&quot;&gt;public static &lt;/span&gt;BeanDefinition &lt;span style=&quot;color:#56a8f5;&quot;&gt;registerAutoProxyCreatorIfNecessary&lt;/span&gt;(BeanDefinitionRegistry registry) {&lt;br&gt;    &lt;span style=&quot;color:#cf8e6d;&quot;&gt;return &lt;/span&gt;&lt;span style=&quot;font-style:italic;&quot;&gt;registerAutoProxyCreatorIfNecessary&lt;/span&gt;(registry, &lt;span style=&quot;color:#cf8e6d;&quot;&gt;null&lt;/span&gt;);&lt;br&gt;}&lt;/pre&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="759" x="1241" y="1730" as="geometry" />
        </mxCell>
        <mxCell id="GGYdeEh8H_lDfbDXhspZ-23" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;background-color: rgb(30, 31, 34);&quot;&gt;&lt;pre style=&quot;font-family: 微软雅黑; font-size: 12pt;&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt;&lt;font color=&quot;#cf8e6d&quot;&gt;public &lt;/font&gt;&lt;font color=&quot;#bcbec4&quot;&gt;BeanDefinition &lt;/font&gt;&lt;/font&gt;&lt;/font&gt;&lt;/font&gt;&lt;/font&gt;&lt;span style=&quot;color: rgb(86, 168, 245);&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt;registerAutoProxyCreatorIfNecessary&lt;/font&gt;&lt;/font&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;font style=&quot;color: rgb(188, 190, 196); vertical-align: inherit;&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt; ( &lt;/font&gt;&lt;/font&gt;&lt;/font&gt;&lt;/font&gt;&lt;font color=&quot;#bcbec4&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;font style=&quot;color: rgb(188, 190, 196); vertical-align: inherit;&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt;       BeanDefinitionRegistry registry，&lt;/font&gt;&lt;/font&gt;&lt;/font&gt;&lt;/font&gt;&lt;span style=&quot;color: rgb(179, 174, 96);&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt;@Nullable&lt;/font&gt;&lt;/font&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;font style=&quot;color: rgb(188, 190, 196); vertical-align: inherit;&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt; Object source) { &lt;/font&gt;&lt;/font&gt;&lt;/font&gt;&lt;/font&gt;&lt;font color=&quot;#bcbec4&quot;&gt;&lt;br&gt;&lt;br&gt;    &lt;/font&gt;&lt;span style=&quot;color: rgb(207, 142, 109);&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt;return &lt;/font&gt;&lt;/font&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(188, 190, 196); font-style: italic;&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt;registerOrEscalateApcAsRequired&lt;/font&gt;&lt;/font&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;font style=&quot;color: rgb(188, 190, 196); vertical-align: inherit;&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt; (InfrastructureAdvisorAutoProxyCreator.class &lt;/font&gt;&lt;/font&gt;&lt;/font&gt;&lt;/font&gt;&lt;span style=&quot;color: rgb(207, 142, 109);&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt;，&lt;/font&gt;&lt;/font&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;font style=&quot;color: rgb(188, 190, 196); vertical-align: inherit;&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt;registry，source); &lt;/font&gt;&lt;/font&gt;&lt;/font&gt;&lt;/font&gt;&lt;font color=&quot;#bcbec4&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;font style=&quot;color: rgb(188, 190, 196); vertical-align: inherit;&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt;&lt;font style=&quot;vertical-align: inherit;&quot;&gt;}&lt;/font&gt;&lt;/font&gt;&lt;/font&gt;&lt;/font&gt;&lt;/pre&gt;&lt;/div&gt;" vertex="1">
