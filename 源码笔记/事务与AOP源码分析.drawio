        <mxCell id="rPPMhUUU6-zgN3zvUCfC-22" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;strokeColor=none;fillColor=#fff2cc;" value="&lt;div&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;判断循环引用过程中代理是否创建, 如果创建过了，则跳过singletonFactories&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="250" x="1370" y="1815" as="geometry" />
