  <diagram id="BKvO34OsFB_e_FXNuG3k" name="AOP源码分析">
    <mxGraphModel dx="5764" dy="3056" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="rPPMhUUU6-zgN3zvUCfC-1" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="2441" width="866.45" x="1860" y="3050" as="geometry" />
        </mxCell>
        <mxCell id="rPPMhUUU6-zgN3zvUCfC-2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;strokeColor=none;fillColor=#fff2cc;" value="&lt;div&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;1. SpringAOP编程核心 动态代理的开发&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;代理设计模式：通过代理类 为原始类（目标）增加额外功能&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;好处：利于原始类（目标类）维护&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;代理设计模式和装饰器设计模式 区别&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;注意：从UML角度&amp;nbsp; 代理设计模式和装饰器设计模式&amp;nbsp; 完全一致&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;区别：代理设计模式&amp;nbsp; ---------&amp;gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; 额外功能的增强&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;   代理设计模式  动态代理概念（可以通过动态字节码技术创建  JDK/CGlib  Javasist  ASM）&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp; &amp;nbsp;装饰器设计模式 -------&amp;gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; 本职功能的增强&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="540" x="650" y="300" as="geometry" />
        </mxCell>
        <mxCell id="rPPMhUUU6-zgN3zvUCfC-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;strokeColor=#6c8ebf;fillColor=#dae8fc;" value="&lt;div&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;SpringAOP 的开发过程&lt;/span&gt;&lt;/div&gt;&lt;div&gt;1. 原始对象【service】&lt;/div&gt;&lt;div&gt;2. 额外功能&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;根据运行时机 原始方法之前 之后 前后 抛出异常时&lt;br&gt;&lt;/div&gt;&lt;div&gt;3. 切入点&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;额外功能增加给那些原始方法，是由切入点决定的&lt;br&gt;&lt;/div&gt;&lt;div&gt;4. 组装切面&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Spring体系&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;Advisor&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;AspectJ注解式开发AOP&amp;nbsp;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Aspect---&amp;gt;@Aspect&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="340" x="650" y="500" as="geometry" />
        </mxCell>
        <mxCell id="rPPMhUUU6-zgN3zvUCfC-4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;strokeColor=none;fillColor=#fff2cc;" value="&lt;div&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;AOP本质就是Spring动态代理&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;两种方式&amp;nbsp; JDK&amp;nbsp; &amp;nbsp; CGLIB&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;JDK 根据&lt;b&gt;接口，&lt;/b&gt;通过动态字节码技术的实现，既保留原始功能，又增加额外功能&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;CGLIB 根据&lt;b&gt;原始类&lt;/b&gt;，通过动态&lt;span style=&quot;background-color: initial;&quot;&gt;字节码技术的实现，&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;既保留原始功能，又增加额外功能&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="520" x="650" y="690" as="geometry" />
        </mxCell>
        <mxCell id="rPPMhUUU6-zgN3zvUCfC-5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;strokeColor=none;fillColor=#fff2cc;" value="&lt;div&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;如果有接口，默认使用JDK&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;通过@EnableAspectJAutoProxy(proxyTargetClass=true)&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;如果没有接口，默认使用CGlib&lt;/div&gt;&lt;div&gt;不能改成JDK&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;在SpringBoot 中如何更改代理创建的方式&lt;/div&gt;&lt;div&gt;手动添加 @EnableAspectJAutoProxy(&lt;span style=&quot;background-color: initial;&quot;&gt;proxyTargetClass=true&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="350" x="1220" y="690" as="geometry" />
        </mxCell>
        <UserObject label="&lt;div style=&quot;background-color:#1e1f22;color:#bcbec4&quot;&gt;&lt;pre style=&quot;font-family:&#39;微软雅黑&#39;;font-size:12.0pt;&quot;&gt;&lt;span style=&quot;color:#b3ae60;&quot;&gt;@Configuration&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#b3ae60;&quot;&gt;@ComponentScan&lt;/span&gt;(&lt;span style=&quot;color:#6aab73;&quot;&gt;&quot;com.zhl.aoppost&quot;&lt;/span&gt;)&lt;br&gt;&lt;span style=&quot;color:#b3ae60;&quot;&gt;@Import&lt;/span&gt;(MyAspectJPostProcessor.&lt;span style=&quot;color:#cf8e6d;&quot;&gt;class&lt;/span&gt;) &lt;span style=&quot;color:#7a7e85;&quot;&gt;// Spring 底层实际上是这样注入的，后来又改成了 @EnableAspectJAutoProxy&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#b3ae60;&quot;&gt;@MyAspectJAutoProxy              &lt;/span&gt;&lt;span style=&quot;color:#7a7e85;&quot;&gt;// 我们自己定义的注解&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#cf8e6d;&quot;&gt;public class &lt;/span&gt;AppConfig {&lt;br&gt;}&lt;/pre&gt;&lt;/div&gt;" id="rPPMhUUU6-zgN3zvUCfC-6">
          <mxCell parent="1" style="text;whiteSpace=wrap;html=1;" vertex="1">
            <mxGeometry height="140" width="890" x="650" y="860" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="rPPMhUUU6-zgN3zvUCfC-7" edge="1" parent="1" source="rPPMhUUU6-zgN3zvUCfC-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="rPPMhUUU6-zgN3zvUCfC-11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rPPMhUUU6-zgN3zvUCfC-8" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#FF0000;" value="" vertex="1">
          <mxGeometry height="20" width="310" x="650" y="920" as="geometry" />
        </mxCell>
        <mxCell id="rPPMhUUU6-zgN3zvUCfC-9" edge="1" parent="1" source="rPPMhUUU6-zgN3zvUCfC-10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="rPPMhUUU6-zgN3zvUCfC-11">
          <mxGeometry relative="1" as="geometry" />
