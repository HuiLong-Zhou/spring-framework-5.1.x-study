        <mxCell id="s7WMvg4QZF4kne-S9XOI-32" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;strokeColor=#6c8ebf;fillColor=#dae8fc;" value="&lt;div&gt;封装了&lt;/div&gt;&lt;div&gt;1. transactionAttributes&lt;/div&gt;&lt;div&gt;2. 切入点方法的名字&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;register()&lt;br&gt;&lt;/div&gt;&lt;div&gt;3. TransactionInterceptor&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;transactionManager&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;beanFactory&lt;br&gt;&lt;/div&gt;" vertex="1">
