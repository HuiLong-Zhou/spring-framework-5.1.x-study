        <mxCell id="s7WMvg4QZF4kne-S9XOI-28" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;strokeColor=none;fillColor=#fff2cc;" value="&lt;div&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;TransactionInfo 核心类型&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;TransactionAttribute&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;TransactionManager&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;TansactionStatus&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;joinpointIdentification&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;增加事务方法的信息&lt;/span&gt;&lt;/div&gt;" vertex="1">
