        <mxCell id="s7WMvg4QZF4kne-S9XOI-46" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#FF0000;" value="" vertex="1">
          <mxGeometry height="41" width="270" x="3670" y="1129" as="geometry" />
        </mxCell>
        <mxCell id="s7WMvg4QZF4kne-S9XOI-48" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;strokeColor=none;fillColor=#fff2cc;" value="&lt;div&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;为什么要设计 oldTransactionInfo？&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;在Spring 事务属性中的传播属性 REQUIRED_NEW 中，外部存在事务，挂起外部事务，开启新的事务，执行完毕后，还原外部事务，&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;关键在于：&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;1. 新的事务如何感知到外部是否有事务&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;2. 如何挂起外部事务，在执行完成后，如何还原外部的事务&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;3. Spring 如何存储 TInfo，后续便于进行事务判断？&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;TInfo 存储在ThreadLocal 中&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="420" x="4220" y="970" as="geometry" />
        </mxCell>
        <mxCell id="s7WMvg4QZF4kne-S9XOI-50" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#FF0000;" value="" vertex="1">
          <mxGeometry height="27" width="240" x="2430" y="1673" as="geometry" />
        </mxCell>
        <mxCell id="s7WMvg4QZF4kne-S9XOI-52" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;" value="把旧的 transactionInfo 放到 ThreadLocal 中，恢复外部事务" vertex="1">
          <mxGeometry height="41.5" width="170" x="2930" y="1665.75" as="geometry" />
        </mxCell>
        <mxCell id="s7WMvg4QZF4kne-S9XOI-53" edge="1" parent="1" source="s7WMvg4QZF4kne-S9XOI-50" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FF0000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="s7WMvg4QZF4kne-S9XOI-52">
