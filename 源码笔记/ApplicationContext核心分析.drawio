        <mxCell id="vnuo9drsxzPIWOMCGWfo-6" value="&lt;div&gt;Spring 内置&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;@Value @Autowired&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;AutowiredAnnotationBeanPostProcessor&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;@Resource @PostConstruct @PreDestroy&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;CommonAnnotationBeanPostProcessor&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;自己通过 @Component 修饰的BeanPostProcessor&lt;/div&gt;&lt;div&gt;会在invokeBeanFactoryPostProcessors方法中完成注册&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;strokeColor=none;fillColor=#fff2cc;" parent="1" vertex="1">
