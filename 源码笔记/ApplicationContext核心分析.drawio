        <mxCell id="BHUGyEWuv7wxAcUc6tVm-10" value="&lt;div&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;把配置文件中&lt;/span&gt;&lt;/div&gt;&lt;div&gt;user.id=10 值替换 ${user.id}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;@Value(&quot;10&quot;)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;strokeColor=none;fillColor=#fff2cc;" vertex="1" parent="1">
