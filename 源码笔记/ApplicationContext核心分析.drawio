        <mxCell id="Gy6R1XkvGKbHDrYxwddj-15" value="&lt;span style=&quot;font-size: 13px;&quot;&gt;add 添加的对象调用&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial; font-size: 13px;&quot;&gt;postProcessBeanDefinitionRegistry&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;strokeColor=none;fillColor=#fff2cc;" vertex="1" parent="1">
