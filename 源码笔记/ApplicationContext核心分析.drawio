        <mxCell id="vnuo9drsxzPIWOMCGWfo-9" value="&lt;div&gt;实例化&lt;/div&gt;&lt;div&gt;singletonObjects&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="2860" y="930" width="120" height="60" as="geometry" />
