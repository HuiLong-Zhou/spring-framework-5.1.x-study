  <diagram id="kQkarYci3ViWZphMfIXR" name="finishBeanFactoryInitialization">
    <mxGraphModel dx="2420" dy="696" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="BHUGyEWuv7wxAcUc6tVm-1" value="&lt;div style=&quot;background-color:#1e1f22;color:#bcbec4&quot;&gt;&lt;pre style=&quot;font-family:&#39;微软雅黑&#39;;font-size:12.0pt;&quot;&gt;&lt;span style=&quot;color:#cf8e6d;&quot;&gt;protected void &lt;/span&gt;&lt;span style=&quot;color:#56a8f5;&quot;&gt;finishBeanFactoryInitialization&lt;/span&gt;(ConfigurableListableBeanFactory beanFactory) {&lt;br&gt;    &lt;span style=&quot;color:#7a7e85;&quot;&gt;// Initialize conversion service for this context. ===&amp;gt;  类型转换器&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#7a7e85;&quot;&gt;    &lt;/span&gt;&lt;span style=&quot;color:#5f826b;font-style:italic;&quot;&gt;/**&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#5f826b;font-style:italic;&quot;&gt;     * 有两种类型转换器，PropertyEditor 和 Converter&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#5f826b;font-style:italic;&quot;&gt;     * 这里使用的是 Converter&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#5f826b;font-style:italic;&quot;&gt;     */&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#5f826b;font-style:italic;&quot;&gt;    &lt;/span&gt;&lt;span style=&quot;color:#cf8e6d;&quot;&gt;if &lt;/span&gt;(beanFactory.containsBean(&lt;span style=&quot;color:#c77dbb;font-style:italic;&quot;&gt;CONVERSION_SERVICE_BEAN_NAME&lt;/span&gt;) &amp;amp;&amp;amp;&lt;br&gt;          beanFactory.isTypeMatch(&lt;span style=&quot;color:#c77dbb;font-style:italic;&quot;&gt;CONVERSION_SERVICE_BEAN_NAME&lt;/span&gt;, ConversionService.&lt;span style=&quot;color:#cf8e6d;&quot;&gt;class&lt;/span&gt;)) {&lt;br&gt;       beanFactory.setConversionService(&lt;br&gt;             beanFactory.getBean(&lt;span style=&quot;color:#c77dbb;font-style:italic;&quot;&gt;CONVERSION_SERVICE_BEAN_NAME&lt;/span&gt;, ConversionService.&lt;span style=&quot;color:#cf8e6d;&quot;&gt;class&lt;/span&gt;));&lt;br&gt;    }&lt;br&gt;&lt;br&gt;    &lt;span style=&quot;color:#7a7e85;&quot;&gt;// Register a default embedded value resolver if no bean post-processor&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#7a7e85;&quot;&gt;    // (such as a PropertyPlaceholderConfigurer bean) registered any before:&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#7a7e85;&quot;&gt;    // at this point, primarily for resolution in annotation attribute values.&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#7a7e85;&quot;&gt;    &lt;/span&gt;&lt;span style=&quot;color:#cf8e6d;&quot;&gt;if &lt;/span&gt;(!beanFactory.hasEmbeddedValueResolver()) {&lt;br&gt;       beanFactory.addEmbeddedValueResolver(strVal -&amp;gt; getEnvironment().resolvePlaceholders(strVal));&lt;br&gt;    }&lt;br&gt;&lt;br&gt;    &lt;span style=&quot;color:#7a7e85;&quot;&gt;// Initialize LoadTimeWeaverAware beans early to allow for registering their transformers early.&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#7a7e85;&quot;&gt;    &lt;/span&gt;String[] weaverAwareNames = beanFactory.getBeanNamesForType(LoadTimeWeaverAware.&lt;span style=&quot;color:#cf8e6d;&quot;&gt;class&lt;/span&gt;, &lt;span style=&quot;color:#cf8e6d;&quot;&gt;false&lt;/span&gt;, &lt;span style=&quot;color:#cf8e6d;&quot;&gt;false&lt;/span&gt;);&lt;br&gt;    &lt;span style=&quot;color:#cf8e6d;&quot;&gt;for &lt;/span&gt;(String weaverAwareName : weaverAwareNames) {&lt;br&gt;       getBean(weaverAwareName);&lt;br&gt;    }&lt;br&gt;&lt;br&gt;    &lt;span style=&quot;color:#7a7e85;&quot;&gt;// Stop using the temporary ClassLoader for type matching.&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#7a7e85;&quot;&gt;    &lt;/span&gt;beanFactory.setTempClassLoader(&lt;span style=&quot;color:#cf8e6d;&quot;&gt;null&lt;/span&gt;);&lt;br&gt;&lt;br&gt;    &lt;span style=&quot;color:#7a7e85;&quot;&gt;// Allow for caching all bean definition metadata, not expecting further changes.&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#7a7e85;&quot;&gt;    &lt;/span&gt;beanFactory.freezeConfiguration();&lt;br&gt;&lt;br&gt;    &lt;span style=&quot;color:#7a7e85;&quot;&gt;// instantiate all remaining (non-lazy-init) singletons.&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#7a7e85;&quot;&gt;    // 整合&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#7a7e85;&quot;&gt;    &lt;/span&gt;beanFactory.preInstantiateSingletons();&lt;br&gt;}&lt;/pre&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="230" y="120" width="560" height="730" as="geometry" />
        </mxCell>
        <mxCell id="BHUGyEWuv7wxAcUc6tVm-3" value="实例化所有剩余的（非惰性初始化）单例&lt;br&gt;在调用这个方法之前，Spring 的ApplicationContext 做了什么？&lt;br&gt;1）注册 BD&lt;br&gt;2）准备 BeanPostProcessor" style="rounded=0;whiteSpace=wrap;html=1;align=left;strokeColor=none;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="1190" y="160" width="339" height="80" as="geometry" />
