        </mxCell>
        <mxCell id="Gy6R1XkvGKbHDrYxwddj-7" value="&lt;div&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;对 BeanDefinitionRegistryPostProcessor 的处理&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;strokeColor=#B20000;fillColor=#e51400;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="1310" y="995" width="290" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Gy6R1XkvGKbHDrYxwddj-8" value="&lt;div&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;对 BeanFactoryPostProcessor 的处理&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;strokeColor=none;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="1300" y="2260" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Gy6R1XkvGKbHDrYxwddj-12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="Gy6R1XkvGKbHDrYxwddj-10" target="Gy6R1XkvGKbHDrYxwddj-8">
